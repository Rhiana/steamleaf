<section class="build-page content-container">
  <h1>Steam Guild</h1>

  <aside class="build-page__box build-page__index steam">
    <h2>Roster</h2>
    <div class="build-page__content">
      <%= turbo_frame_tag 'anyframe' do %>
        <div>
          <h3>Points: <%= local_assigns[:unitpoints] %> / <%= @points %></h3>
          <%= form_with scope: :any, url: turbo_frame_submit_path, local: true do |form| %>
            <%= form.label :unitpoints, 'Unit points'  %>
            <%= form.text_field :unitpoints, type: 'number', 'required' => 'true', 'value' => "0",  'aria-describedby' => 'unitpoints' %>
            <%= form.submit 'Add Unit', 'id' => 'submit-number', class: "button button--dark" %>
          <% end %>
        <div>
      <% end %>
    </div>
  </aside>

  <article class="build-page__box build-page__info steam">
    <h2>Units</h2>
    <div class="build-page__content">
      <h3>Leaders</h3>

      <div>
        <%= image_tag "cards/Comm_Badger_GuildMaster.png", alt: "Badger GuildMaster" %>
        <div class="build-page__card-info">
          <p><strong>Badger GuildMaster:</strong><br/>50 Points</p>
          <ul>
            <li><strong>Move:</strong> 4 + D6</li>
            <li><strong>Attack:</strong> D8</li>
            <li><strong>Defence:</strong> D8</li>
            <li><strong>Resolve:</strong> D10</li>
            <li><strong>Health:</strong> 12</li>
            <li>
              <strong>Special Abilities:</strong>
              <ul>
                <li>
                  increases the
                  Resolve and
                  Defence dice size of
                  Followers
                </li>
                <li>
                  you may choose 1
                  extra tactical card
                </li>
              </ul>
            </li>
          </ul>
        </div>
      </div>

      <div>
        <%= image_tag "cards/Comm_Beaver_Engineer.png", alt: "Beaver Engineer" %>
        <div class="build-page__card-info">
          <p><strong>Beaver Engineer:</strong><br/>30 Points</p>
          <ul>
            <li><strong>Move:</strong> 4 + D4</li>
            <li><strong>Attack:</strong> D6</li>
            <li><strong>Defence:</strong> D10</li>
            <li><strong>Resolve:</strong> D8</li>
            <li><strong>Health:</strong> 10</li>
            <li>
              <strong>Special Abilities:</strong>
              <ul>
                <li>
                  you may choose 2
                  extra equipment
                  cards
                </li>
              </ul>
            </li>
          </ul>
        </div>
      </div>

      <div>
        <%= image_tag "cards/Comm_Weasel_Taskmaster.png", alt: "Weasel Taskmaster" %>
        <div class="build-page__card-info">
          <p><strong>Weasel Taskmaster:</strong><br/>40 Points</p>
          <ul>
            <li><strong>Move:</strong> 6 + D4</li>
            <li><strong>Attack:</strong> D8</li>
            <li><strong>Defence:</strong> D8</li>
            <li><strong>Resolve:</strong> D12</li>
            <li><strong>Health:</strong> 10</li>
            <li>
              <strong>Special Abilities:</strong>
              <ul>
                <li>
                  increases the
                  Move dice size of
                  Followers
                </li>
                <li>
                  reduces the Resolve
                  dice size of enemy
                  targets during
                  interrogation
                </li>
              </ul>
            </li>
          </ul>
        </div>
      </div>


      <h3>Followers</h3>

      <div>
        <%= image_tag "cards/Comm_BadgerSoldier.png", alt: "Badger Soldier" %>
        <div class="build-page__card-info">
          <p><strong>Badger Soldier:</strong><br/>10 Points</p>
          <ul>
            <li><strong>Move:</strong> 4 + D4</li>
            <li><strong>Attack:</strong> D6</li>
            <li><strong>Defence:</strong> D6</li>
            <li><strong>Resolve:</strong> D8</li>
            <li><strong>Health:</strong> 5</li>
          </ul>
        </div>
      </div>

      <div>
        <%= image_tag "cards/Comm_Badger_Marksman.png", alt: "Badger Marksman" %>
        <div class="build-page__card-info">
          <p><strong>Badger Marksman:</strong><br/>20 Points</p>
          <ul>
            <li><strong>Move:</strong> 4 + D4</li>
            <li><strong>Attack:</strong> D8</li>
            <li><strong>Defence:</strong> D6</li>
            <li><strong>Resolve:</strong> D8</li>
            <li><strong>Health:</strong> 5</li>
            <li><strong>Range:</strong> 4 + D4</li>
          </ul>
        </div>
      </div>

      <div>
        <%= image_tag "cards/Comm_Weasel_Tracker.png", alt: "Weasel Tracker" %>
        <div class="build-page__card-info">
          <p><strong>Weasel Tracker:</strong><br/>15 Points</p>
          <ul>
            <li><strong>Move:</strong> 6 + D4</li>
            <li><strong>Attack:</strong> D8</li>
            <li><strong>Defence:</strong> D6</li>
            <li><strong>Resolve:</strong> D6</li>
            <li><strong>Health:</strong> 4</li>
            <li><strong>Range:</strong> D6</li>
          </ul>
        </div>
      </div>
    </div>
  </article>
</section>