<section class="build-page content-container">
  <h1>Leaf Coven</h1>

  <aside class="build-page__box build-page__index leaf">
    <h2>Roster</h2>
    <div class="build-page__content">
      <%= turbo_frame_tag 'anyframe' do %>
        <div>
          <h3>Points: <%= local_assigns[:unitpoints] %> / <%= @points %></h3>
          <%= form_with scope: :any, url: turbo_frame_submit_path, local: true do |form| %>
            <%= form.label :unitpoints, 'Unit points'  %>
            <%= form.text_field :unitpoints, type: 'number', 'required' => 'true', 'value' => "0",  'aria-describedby' => 'unitpoints' %>
            <%= form.submit 'Add Unit', 'id' => 'submit-number', class: "button button--dark" %>
          <% end %>
        <div>
      <% end %>
    </div>
  </aside>

  <article class="build-page__box build-page__info leaf">
    <h2>Units</h2>
    <div class="build-page__content">
      <h3>Leaders</h3>

      <div>
        <%= image_tag "cards/Comm_Fox_Ranger.png", alt: "Fox Ranger" %>
        <div class="build-page__card-info">
          <p><strong>Fox Ranger:</strong><br/>50 Points</p>
          <ul>
            <li><strong>Move:</strong> 6 + D6</li>
            <li><strong>Attack:</strong> D10</li>
            <li><strong>Defence:</strong> D6</li>
            <li><strong>Resolve:</strong> D10</li>
            <li><strong>Health:</strong> 10</li>
            <li>
              <strong>Special Abilities:</strong>
              <ul>
                <li>
                  increases the Move
                  and Defence dice
                  size of Followers
                </li>
                <li>
                  you may choose 1
                  extra tactical card
                </li>
              </ul>
            </li>
          </ul>
        </div>
      </div>

      <div>
        <%= image_tag "cards/Comm_Racoon_LeafMage.png", alt: "Racoon Leaf Mage" %>
        <div class="build-page__card-info">
          <p><strong>Racoon Leaf Mage:</strong><br/>40 Points</p>
          <ul>
            <li><strong>Move:</strong> 6 + D4</li>
            <li><strong>Attack:</strong> D8</li>
            <li><strong>Defence:</strong> D8</li>
            <li><strong>Resolve:</strong> D12</li>
            <li><strong>Health:</strong> 8</li>
            <li>
              <strong>Special Abilities:</strong>
              <ul>
                <li>
                  you may choose 1
                  extra charm card
                </li>
              </ul>
            </li>
          </ul>
        </div>
      </div>

      <div>
        <%= image_tag "cards/Comm_Bobcat_Beguiler.png", alt: "Bobcat Beguiler" %>
        <div class="build-page__card-info">
          <p><strong>Bobcat Beguiler:</strong><br/>40 Points</p>
          <ul>
            <li><strong>Move:</strong> 8 + D4</li>
            <li><strong>Attack:</strong> D10</li>
            <li><strong>Defence:</strong> D8</li>
            <li><strong>Resolve:</strong> D10</li>
            <li><strong>Health:</strong> 10</li>
            <li>
              <strong>Special Abilities:</strong>
              <ul>
                <li>
                  Increases the
                  Resolve dice size of
                  Followers
                </li>
                <li>
                  reduces the Resolve
                  dice size of enemy
                  targets during
                  interrogation
                </li>
              </ul>
            </li>
          </ul>
        </div>
      </div>

      <h3>Followers</h3>

      <div>
        <%= image_tag "cards/Comm_Fox_Scout.png", alt: "Fox Scout" %>
        <div class="build-page__card-info">
          <p><strong>Fox Scout:</strong><br/>10 Points</p>
          <ul>
            <li><strong>Move:</strong> 4 + D6</li>
            <li><strong>Attack:</strong> D6</li>
            <li><strong>Defence:</strong> D4</li>
            <li><strong>Resolve:</strong> D10</li>
            <li><strong>Health:</strong> 4</li>
            <li><strong>Range:</strong> D6</li>
          </ul>
        </div>
      </div>

      <div>
        <%= image_tag "cards/FoxArcher_Comm.png", alt: "Fox Archer" %>
        <div class="build-page__card-info">
          <p><strong>Fox Archer:</strong><br/>15 Points</p>
          <ul>
            <li><strong>Move:</strong> 4 + D6</li>
            <li><strong>Attack:</strong> D8</li>
            <li><strong>Defence:</strong> D4</li>
            <li><strong>Resolve:</strong> D10</li>
            <li><strong>Health:</strong> 4</li>
            <li><strong>Range:</strong> 4 + D6</li>
          </ul>
        </div>
      </div>

      <div>
        <%= image_tag "cards/Comm_Bobcat_Brawler.png", alt: "Bobcat Brawler" %>
        <div class="build-page__card-info">
          <p><strong>Bobcat Brawler:</strong><br/>20 Points</p>
          <ul>
            <li><strong>Move:</strong> 6 + D6</li>
            <li><strong>Attack:</strong> D8</li>
            <li><strong>Defence:</strong> D6</li>
            <li><strong>Resolve:</strong> D8</li>
            <li><strong>Health:</strong> 5</li>
          </ul>
        </div>
      </div>
    </div>
  </article>
</section>